  "_about": "Hand-computed oracle for docs/specs/accounting.md (A*), ustva.md (U*), zm.md (Z*), credit-notes-payments.md (P*). Written by hand from the specs on 2026-11-23 and cross-checked with fractions.Fraction; NEVER regenerate it from the code under test. All figures fake. Amounts are integer cents.",
  "_schema": {
    "journal_cases": "events -> expected entries (in posting order; events without an entry are listed under no_entry_events; an event that posts two entries names them with part: bill/pay or wo_reversal/payment; document_date is given where it differs from booking_date) and booked VAT sums per month by tax key",
    "event types": {
      "issue": "{id, date, service_to?, treatment, rates: {rate: {net, vat}}, customer?}",
      "payment": "{invoice, date, amount} (negative amount = refund)",
      "credit_note": "{id, invoice, date, credit_kind, rates: {rate: {net, vat}}}",
      "expense": "{id, date, service_date?, paid_on?, treatment, lines: [{net, vat, rate, pct, vat_pct, category}]}",
      "manual": "{template, date, amount}"
    },
    "line": "[role, amount_cents (+debit/-credit), {tax_key, tax_kind, tax_base, vat_date, income_date}] - fields omitted are null",
    "vat": "{YYYY-MM: {tax_key: {base, tax, input}}} booked sums (tax/input as VAT effect: output positive, input positive)",
    "ustva_cases": "journal-line sums in -> boxes out (form figures; booked figures where they differ)",
    "customers": "customer ids are symbolic; tests give them format-valid fake VAT ids"
  },
