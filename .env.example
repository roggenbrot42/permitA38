# Copy to .env and edit:  cp .env.example .env
# docker compose reads it automatically (see docs/docker.md for every variable).
# .env is git-ignored – never commit it.

# --- first-run boss account (recommended for servers: closes the public setup page) ---
PERMITA38_BOOTSTRAP_USERNAME=owner
PERMITA38_BOOTSTRAP_NAME=Your Name
PERMITA38_BOOTSTRAP_COMPANY=Your Business
# use a long random password, or prefer PERMITA38_BOOTSTRAP_PASSWORD_FILE with a Docker secret
PERMITA38_BOOTSTRAP_PASSWORD=change-me-to-a-long-random-password

# --- optional ---
# PERMITA38_SECRET_KEY=            # >= 16 chars; default: generated once and stored in the data volume
# PERMITA38_TOKEN_TTL_HOURS=12
# PERMITA38_LOG_LEVEL=info
# PERMITA38_TRUST_PROXY=true       # only behind a reverse proxy (docker-compose.proxy.yml sets it)
# PERMITA38_COOKIE_SECURE=true     # default: automatic (https / X-Forwarded-Proto)

# --- reverse proxy example (docker-compose.proxy.yml) ---
# PERMITA38_DOMAIN=permita.example.com
